<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is at the platform's 30-minute floor: it is what rotates the resurfaced
  entry over time. Writes also refresh the widget immediately, so it never looks frozen while
  the app is actually being used.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout" />
