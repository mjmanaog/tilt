<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card gradient. Glance cannot render a Compose Brush, so the in-app card gradient
  is mirrored here as a shape drawable. Colours come from the shared palette in colors.xml, so
  the two stay in step.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="@color/tilt_surface_lift"
        android:endColor="@color/tilt_ground"
        android:type="linear" />
</shape>
